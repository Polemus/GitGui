# Generated by build/windows/winget/generate.sh in https://github.com/Polemus/Omnigit.
# Do not edit this copy: edit build/windows/winget/*.in and generate it again.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.12.0.schema.json

PackageIdentifier: Polemus.Omnigit
PackageVersion: @VERSION@
InstallerType: inno

# winget knows Inno's switches, but naming them is what every merged Inno
# manifest does and it costs nothing to be explicit. /SP- suppresses the
# "This will install..." prompt, which would otherwise wait for a keypress in a
# window nobody is looking at.
InstallerSwitches:
  Silent: /SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART
  SilentWithProgress: /SP- /SILENT /SUPPRESSMSGBOXES /NORESTART

# Inno registers its uninstall entry as <AppId>_is1, and AppId in
# build/windows/omnigit.iss is {9F2C6B31-7A4E-4D18-9C55-2E7B1A4F8D30}. Without
# this, `winget upgrade` cannot match an installed Omnigit to this package and
# every release looks like a fresh install that never happened.
ProductCode: '{9F2C6B31-7A4E-4D18-9C55-2E7B1A4F8D30}_is1'

# The installer replaces in place; there is nothing to uninstall first.
UpgradeBehavior: install

# omnigit.iss leaves PrivilegesRequired at Inno's default of admin, so a silent
# install is machine-wide and elevates itself. PrivilegesRequiredOverridesAllowed
# only offers the user a choice in the interactive case, which is not this one.
ElevationRequirement: elevatesSelf

ReleaseDate: @RELEASE_DATE@

Installers:
- Architecture: x64
  Scope: machine
  InstallerUrl: https://github.com/Polemus/Omnigit/releases/download/v@VERSION@/Omnigit-@VERSION@-win-x64-setup.exe
  InstallerSha256: @SHA256_INSTALLER@

ManifestType: installer
ManifestVersion: 1.12.0
