# Maintainer: Polemus <112549+Polemus@users.noreply.github.com>
#
# Generated by build/linux/aur/generate.sh from build/linux/aur/PKGBUILD.in.
# Do not edit this copy.
#
# -bin: installs the release build rather than compiling, so there is no .NET SDK
# build to keep working on Arch.

pkgname=omnigit-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Desktop git client for GitHub, Gitea and other forges"
arch=('x86_64' 'aarch64')
url="https://github.com/Polemus/Omnigit"
license=('MIT')

# namcap reports openssl, libx11, libice and libsm as "may not be needed". They
# are dlopen-ed (libgit2, Avalonia.X11), so it cannot see them; drop one and the
# app installs and dies on startup.
#
# No zlib: nothing links or dlopens libz. No icu: the csproj sets
# InvariantGlobalization. If that is ever removed, icu belongs here.
depends=(
    'glibc'
    'gcc-libs'
    'fontconfig'
    'openssl'
    'libx11'
    'libice'
    'libsm'
    'hicolor-icon-theme'
)

# The app checks for these and degrades rather than failing.
optdepends=(
    'libsecret: keep access tokens in the system keyring instead of a 0600 file'
    'xdg-utils: open a changed file in your desktop’s default application'
    'lttng-ust: .NET runtime tracing, loaded only when tracing is switched on'
)

provides=('omnigit')
conflicts=('omnigit')

# Stripping a published .NET tree breaks it, and DebugType=None leaves no symbols.
options=('!strip' '!debug')

# Two sources: the release tarball holds only the app, so the desktop entry,
# metainfo, icons and licence come from the tagged source archive.
# The binary sources keep their upstream names - renaming them to include the
# architecture makes namcap ask for $CARCH, which makepkg would expand once and
# stamp the building machine's architecture onto both .SRCINFO entries.
source=("omnigit-$pkgver-meta.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
#
# The two binary sources keep their upstream filenames rather than being renamed
# with `::`. namcap otherwise objects to the literal "x86_64" in a local name and
# asks for $CARCH - which would be wrong here, because makepkg expands it once
# when writing .SRCINFO and would stamp the building machine's architecture onto
# both entries. The meta source does need a rename: "v0.2.2.tar.gz" is a name
# every project on the AUR would share in the source cache.
source_x86_64=("$url/releases/download/v$pkgver/Omnigit-$pkgver-linux-x64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/Omnigit-$pkgver-linux-arm64.tar.gz")

sha256sums=('@SHA256_META@')
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
    # Desktop files are named after the app id, not the binary.
    local appid=io.github.polemus.Omnigit
    local meta="$srcdir/Omnigit-$pkgver"

    install -d "$pkgdir/usr/lib"
    cp -a "$srcdir/omnigit" "$pkgdir/usr/lib/omnigit"
    chmod 755 "$pkgdir/usr/lib/omnigit/Omnigit"

    # Exec= in the desktop entry is plain "omnigit", so it must be on PATH.
    install -d "$pkgdir/usr/bin"
    ln -sf ../lib/omnigit/Omnigit "$pkgdir/usr/bin/omnigit"

    install -Dm644 "$meta/build/linux/$appid.desktop" \
        "$pkgdir/usr/share/applications/$appid.desktop"
    install -Dm644 "$meta/build/linux/$appid.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/$appid.metainfo.xml"

    local size
    for size in 16 32 48 64 128 256; do
        install -Dm644 "$meta/build/linux/icons/omnigit-$size.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$appid.png"
    done
    install -Dm644 "$meta/src/Omnigit/Assets/omnigit.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$appid.svg"

    # MIT is not in /usr/share/licenses/common, so the text must ship.
    install -Dm644 "$meta/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
