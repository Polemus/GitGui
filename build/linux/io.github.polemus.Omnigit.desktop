# Named after the app id rather than the binary, because Flatpak requires every
# exported file to carry the app id, and AppStream needs this file name to match
# the <launchable> in io.github.polemus.Omnigit.metainfo.xml. The .deb, .rpm and
# AppImage install it under the same name so there is only one of these.
#
# Exec=omnigit works in all four: /usr/bin/omnigit is a symlink in the packages,
# /app/bin/omnigit is one in the Flatpak, and the AppImage starts through AppRun.
# No %U or %F - the app takes no path argument, so promising to accept one would
# only mean a file manager handing it something it ignores.
[Desktop Entry]
Type=Application
Name=Omnigit
GenericName=Git Client
Comment=Desktop git client for GitHub, Gitea and other forges
Exec=omnigit
Icon=io.github.polemus.Omnigit
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;github;gitea;version control;vcs;
StartupWMClass=Omnigit
