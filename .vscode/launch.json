{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Omnigit",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Omnigit/bin/Debug/net10.0/Omnigit",
            "args": [],
            "cwd": "${workspaceFolder}/src/Omnigit",
            "console": "internalConsole",
            "stopAtEntry": false,
            // Only step through our own code; framework and Avalonia assemblies
            // are treated as external (this is the default, stated explicitly).
            "justMyCode": true,
            // Suppresses the per-assembly "Loaded '...dll'" chatter in the
            // Debug Console. Flip moduleLoad back to true if you ever need to
            // confirm which build of an assembly actually got loaded.
            "logging": {
                "moduleLoad": false
            }
        }
    ]
}
