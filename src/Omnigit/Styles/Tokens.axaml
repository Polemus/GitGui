<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        THE brand colour. Single source of truth - declared outside the theme
        dictionaries because it is variant-independent.

        App.Initialize() reads this key and pushes it into FluentAvaloniaTheme's
        CustomAccentColor, which regenerates the SystemAccentColor* palette that
        stock controls (CheckBox, ToggleSwitch, Slider, focus rings) draw from.
        So changing this one value restyles both our own styles and every stock
        control - there is no second place to update.

        The per-variant AccentBrush values below are the ramp our own styles use.
        Light deliberately deepens the brand colour so white text on it clears
        WCAG AA; that lands at #2B87B5, within 8/255 of the #2B82AD FluentAvalonia
        independently derives for light theme, so stock and custom controls match.
    -->
    <Color x:Key="BrandAccentColor">#3399CC</Color>

    <!--
        Every colour the app uses is declared here once per theme variant.
        Views reference these with DynamicResource so switching Dark/Light at
        runtime repaints without a restart.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="AppBackground" Color="#16181D" />
            <SolidColorBrush x:Key="ToolbarBackground" Color="#1C1F26" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#1A1D23" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#121418" />
            <SolidColorBrush x:Key="ElevatedBackground" Color="#20242C" />
            <!-- Dims the app behind a prompt that has to be answered. -->
            <SolidColorBrush x:Key="ScrimBackground" Color="#0B0D11" Opacity="0.66" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#2A2F3A" />
            <SolidColorBrush x:Key="BorderStrong" Color="#3A404E" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary" Color="#E6E9EF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9BA3B4" />
            <SolidColorBrush x:Key="TextMuted" Color="#6B7385" />
            <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

            <!-- Interaction -->
            <SolidColorBrush x:Key="AccentBrush" Color="#3399CC" />
            <SolidColorBrush x:Key="AccentHover" Color="#47A9DA" />
            <SolidColorBrush x:Key="AccentPressed" Color="#2A80AC" />
            <SolidColorBrush x:Key="HoverBackground" Color="#232833" />
            <SolidColorBrush x:Key="SelectedBackground" Color="#1F3B4D" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />

            <!-- Diff -->
            <SolidColorBrush x:Key="DiffAddBackground" Color="#12261A" />
            <SolidColorBrush x:Key="DiffAddGutter" Color="#18351F" />
            <SolidColorBrush x:Key="DiffAddText" Color="#7EE787" />
            <SolidColorBrush x:Key="DiffRemoveBackground" Color="#2A1416" />
            <SolidColorBrush x:Key="DiffRemoveGutter" Color="#3A181C" />
            <SolidColorBrush x:Key="DiffRemoveText" Color="#FFA198" />
            <SolidColorBrush x:Key="DiffHunkBackground" Color="#1A2233" />
            <SolidColorBrush x:Key="DiffHunkText" Color="#79A6E8" />
            <SolidColorBrush x:Key="DiffCodeText" Color="#C9D1D9" />
            <SolidColorBrush x:Key="DiffGutterText" Color="#5A6272" />

            <!-- File status -->
            <SolidColorBrush x:Key="StatusAdded" Color="#3FB950" />
            <SolidColorBrush x:Key="StatusModified" Color="#D29922" />
            <SolidColorBrush x:Key="StatusDeleted" Color="#F85149" />
            <SolidColorBrush x:Key="StatusRenamed" Color="#58A6FF" />

            <!-- Banners -->
            <SolidColorBrush x:Key="BannerErrorBackground" Color="#2A1416" />
            <SolidColorBrush x:Key="BannerErrorBorder" Color="#F85149" />
            <SolidColorBrush x:Key="BannerInfoBackground" Color="#1A2233" />
            <SolidColorBrush x:Key="BannerInfoBorder" Color="#3399CC" />
            <!-- Something is waiting on the user. Red would say it had gone wrong; a
                 stopped merge has not gone wrong, it has stopped. -->
            <SolidColorBrush x:Key="BannerWarningBackground" Color="#2A2213" />
            <SolidColorBrush x:Key="BannerWarningBorder" Color="#D29922" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToolbarBackground" Color="#F4F5F7" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#FAFBFC" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ElevatedBackground" Color="#FFFFFF" />
            <!-- Dims the app behind a prompt that has to be answered. -->
            <SolidColorBrush x:Key="ScrimBackground" Color="#1B1F24" Opacity="0.44" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#E1E4E8" />
            <SolidColorBrush x:Key="BorderStrong" Color="#CFD4DA" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
            <SolidColorBrush x:Key="TextSecondary" Color="#59636E" />
            <SolidColorBrush x:Key="TextMuted" Color="#848D97" />
            <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

            <!-- Interaction -->
            <!-- Deepened a shade from #3399CC so white button text clears WCAG AA. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#2B87B5" />
            <SolidColorBrush x:Key="AccentHover" Color="#3399CC" />
            <SolidColorBrush x:Key="AccentPressed" Color="#226E93" />
            <SolidColorBrush x:Key="HoverBackground" Color="#F0F1F3" />
            <SolidColorBrush x:Key="SelectedBackground" Color="#DCEDF7" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />

            <!-- Diff -->
            <SolidColorBrush x:Key="DiffAddBackground" Color="#E6FFEC" />
            <SolidColorBrush x:Key="DiffAddGutter" Color="#CCFFD8" />
            <SolidColorBrush x:Key="DiffAddText" Color="#116329" />
            <SolidColorBrush x:Key="DiffRemoveBackground" Color="#FFEBE9" />
            <SolidColorBrush x:Key="DiffRemoveGutter" Color="#FFD7D5" />
            <SolidColorBrush x:Key="DiffRemoveText" Color="#82071E" />
            <SolidColorBrush x:Key="DiffHunkBackground" Color="#EAF1FB" />
            <SolidColorBrush x:Key="DiffHunkText" Color="#0550AE" />
            <SolidColorBrush x:Key="DiffCodeText" Color="#24292F" />
            <SolidColorBrush x:Key="DiffGutterText" Color="#8C959F" />

            <!-- File status -->
            <SolidColorBrush x:Key="StatusAdded" Color="#1A7F37" />
            <SolidColorBrush x:Key="StatusModified" Color="#9A6700" />
            <SolidColorBrush x:Key="StatusDeleted" Color="#CF222E" />
            <SolidColorBrush x:Key="StatusRenamed" Color="#0969DA" />

            <!-- Banners -->
            <SolidColorBrush x:Key="BannerErrorBackground" Color="#FFEBE9" />
            <SolidColorBrush x:Key="BannerErrorBorder" Color="#CF222E" />
            <SolidColorBrush x:Key="BannerInfoBackground" Color="#EAF1FB" />
            <SolidColorBrush x:Key="BannerInfoBorder" Color="#2B87B5" />
            <SolidColorBrush x:Key="BannerWarningBackground" Color="#FFF8C5" />
            <SolidColorBrush x:Key="BannerWarningBorder" Color="#9A6700" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
        The UI font, named by its avares URI so the copy embedded in
        Avalonia.Fonts.Inter is the one used.

        WithInterFont() in Program.cs is not enough on its own: it supplies a
        *default* family, which only applies where nothing else resolves, so
        controls inherit whatever fontconfig calls the default sans instead. That
        is Adwaita Sans on a current Fedora - a fork of Inter, so it looks nearly
        right - and DejaVu Sans inside the Flatpak runtime, which is 15% wider at
        the same size and looks obviously wrong beside it. Asking for the embedded
        file by URI takes the system out of the decision entirely.
    -->
    <FontFamily x:Key="UiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

    <!-- No mono font is embedded; this is a fallback chain across the three platforms. -->
    <FontFamily x:Key="MonoFont">Cascadia Mono,JetBrains Mono,DejaVu Sans Mono,SF Mono,Menlo,Consolas,monospace</FontFamily>

    <!--
        Icons are stroked paths on a 16x16 box so they stay crisp at any DPI and
        pick up Foreground from whatever control hosts them.
    -->
    <StreamGeometry x:Key="IconChevronDown">M 4,6.5 L 8,10.5 L 12,6.5</StreamGeometry>

    <StreamGeometry x:Key="IconRepo">M 4,1.5 h 8.5 a 1,1 0 0 1 1,1 v 12 h -9.5 a 1.5,1.5 0 0 1 -1.5,-1.5 v -10 a 1.5,1.5 0 0 1 1.5,-1.5 z M 3,12 h 10.5</StreamGeometry>

    <StreamGeometry x:Key="IconBranch">M 2,3.5 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0 M 2,12.5 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0 M 10,3.5 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0 M 4,5.5 L 4,10.5 M 12,5.5 C 12,9.2 4,7.8 4,10.5</StreamGeometry>

    <StreamGeometry x:Key="IconSync">M 14,8 A 6,6 0 1 1 11.9,3.4 M 10.8,1.4 L 12.4,3.6 L 10.1,4.9</StreamGeometry>

    <StreamGeometry x:Key="IconPerson">M 8,2.6 a 2.7,2.7 0 1,0 0,5.4 a 2.7,2.7 0 1,0 0,-5.4 M 2.6,14 a 5.4,5.4 0 0 1 10.8,0</StreamGeometry>

    <!-- Gear: one continuous outline whose teeth are part of the silhouette, plus the
         bore. Teeth drawn as separate spokes off a ring read as a sun, not a gear. -->
    <StreamGeometry x:Key="IconSettings">M 12.92,7.09 L 14.77,6.68 A 6.9,6.9 0 0 1 14.77,9.32 L 12.92,8.91 A 5.0,5.0 0 0 1 12.12,10.83 L 13.72,11.86 A 6.9,6.9 0 0 1 11.86,13.72 L 10.83,12.12 A 5.0,5.0 0 0 1 8.91,12.92 L 9.32,14.77 A 6.9,6.9 0 0 1 6.68,14.77 L 7.09,12.92 A 5.0,5.0 0 0 1 5.17,12.12 L 4.14,13.72 A 6.9,6.9 0 0 1 2.28,11.86 L 3.88,10.83 A 5.0,5.0 0 0 1 3.08,8.91 L 1.23,9.32 A 6.9,6.9 0 0 1 1.23,6.68 L 3.08,7.09 A 5.0,5.0 0 0 1 3.88,5.17 L 2.28,4.14 A 6.9,6.9 0 0 1 4.14,2.28 L 5.17,3.88 A 5.0,5.0 0 0 1 7.09,3.08 L 6.68,1.23 A 6.9,6.9 0 0 1 9.32,1.23 L 8.91,3.08 A 5.0,5.0 0 0 1 10.83,3.88 L 11.86,2.28 A 6.9,6.9 0 0 1 13.72,4.14 L 12.12,5.17 Z M 10.2,8 A 2.2,2.2 0 1 1 5.8,8 A 2.2,2.2 0 1 1 10.2,8 Z</StreamGeometry>

    <StreamGeometry x:Key="IconPlus">M 8,3.5 L 8,12.5 M 3.5,8 L 12.5,8</StreamGeometry>

    <StreamGeometry x:Key="IconSun">M 8,5.2 a 2.8,2.8 0 1,0 0,5.6 a 2.8,2.8 0 1,0 0,-5.6 M 8,1 L 8,2.5 M 8,13.5 L 8,15 M 1,8 L 2.5,8 M 13.5,8 L 15,8 M 3.05,3.05 L 4.1,4.1 M 11.9,11.9 L 12.95,12.95 M 12.95,3.05 L 11.9,4.1 M 4.1,11.9 L 3.05,12.95</StreamGeometry>

    <StreamGeometry x:Key="IconMoon">M 13.4,10.3 A 6.2,6.2 0 1 1 5.9,2.4 A 5.2,5.2 0 0 0 13.4,10.3 Z</StreamGeometry>

    <StreamGeometry x:Key="IconCheck">M 3.5,8.5 L 6.5,11.5 L 12.5,4.5</StreamGeometry>

    <StreamGeometry x:Key="IconGlobe">M 8,1.5 a 6.5,6.5 0 1,0 0,13 a 6.5,6.5 0 1,0 0,-13 M 1.5,8 L 14.5,8 M 8,1.5 C 5.5,4 5.5,12 8,14.5 M 8,1.5 C 10.5,4 10.5,12 8,14.5</StreamGeometry>

</ResourceDictionary>
