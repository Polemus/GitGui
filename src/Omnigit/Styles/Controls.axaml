<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Typography ===================== -->

    <!--
        Set on the window so everything inherits it. Without this the app renders
        in whatever fontconfig calls the default sans, which differs per machine
        and per sandbox - see the UiFont note in Tokens.axaml.
    -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.sectionLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Host group headings inside the repository picker. Quieter than the rows they
         label, so a group of one still reads as a heading and not another row. -->
    <Style Selector="TextBlock.groupLabel">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        FluentAvalonia's Button theme animates the ContentPresenter's background
        between states. Our classes set their own hover colours on top of that,
        so the interpolation between the two reads as a bright flash on pointer
        enter. Dropping the transition makes hover switch instantly.
    -->
    <Style Selector="Button.toolbarItem /template/ ContentPresenter,
                     Button.iconButton /template/ ContentPresenter,
                     Button.rowButton /template/ ContentPresenter,
                     Button.primary /template/ ContentPresenter,
                     Button.secondary /template/ ContentPresenter,
                     Button.tab /template/ ContentPresenter,
                     Button.addButton /template/ ContentPresenter,
                     Button.repoPicker /template/ ContentPresenter">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <!-- ===================== Toolbar ===================== -->

    <!-- The wide dropdown buttons: repository picker, branch picker, sync. -->
    <Style Selector="Button.toolbarItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.toolbarItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>

    <Style Selector="Button.toolbarItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
    </Style>

    <!-- Small square icon button (theme toggle, overflow menu). -->
    <Style Selector="Button.iconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- The repository picker at the top of the sidebar. Full width, no border of its
         own: the divider below it is what separates it from the tabs. -->
    <Style Selector="Button.repoPicker">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.repoPicker:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- The + in the header. Outlined rather than accent-filled: the accent is spent on
         the wordmark and the active tab, and a third use in the same 60px strip stops
         any of them meaning anything. Size and border carry it instead. -->
    <Style Selector="Button.addButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.addButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- Selectors match the exact type, so this names Path directly rather than relying
         on the .icon class. Heavier stroke so the glyph holds its own unfilled. -->
    <Style Selector="Button.addButton Path">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
        <Setter Property="StrokeThickness" Value="1.9" />
    </Style>

    <!-- ===================== Check boxes ===================== -->

    <!-- Stock CheckBox fills itself with SystemAccentColor when ticked, which put a
         column of blue down the whole changes list. Neutral instead: the tick is what
         says it is on. Part names are FluentAvalonia's template. -->
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource TextMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="CheckBox:indeterminate /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ===================== Primary action ===================== -->

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- Vertical tab in the settings rail. The active one carries an accent edge rather
         than a filled background, so the rail stays quiet as sections are added. -->
    <Style Selector="Button.settingsTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.settingsTab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <Style Selector="Button.settingsTab.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.settingsTab.active /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- Reads as a hyperlink, behaves as a command. Used where text is an action. -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <!-- Flat row used inside picker flyouts and list overlays. -->
    <Style Selector="Button.rowButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.rowButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- ===================== Tabs ===================== -->

    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <Style Selector="Button.tab.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===================== Inputs ===================== -->

    <Style Selector="TextBox.commitBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox.commitBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===================== Badges &amp; chips ===================== -->

    <!-- Square host badge carrying the forge's brand colour. -->
    <Style Selector="Border.hostBadge">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tag badge in the history list. Accent-tinted so a released commit is findable
         by colour while scrolling, rather than reading every row. -->
    <Style Selector="Border.tagBadge">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.tagBadge > TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===================== File status letters ===================== -->

    <Style Selector="TextBlock.statusGlyph">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Width" Value="14" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.statusGlyph.added">
        <Setter Property="Foreground" Value="{DynamicResource StatusAdded}" />
    </Style>
    <Style Selector="TextBlock.statusGlyph.modified">
        <Setter Property="Foreground" Value="{DynamicResource StatusModified}" />
    </Style>
    <Style Selector="TextBlock.statusGlyph.deleted">
        <Setter Property="Foreground" Value="{DynamicResource StatusDeleted}" />
    </Style>
    <Style Selector="TextBlock.statusGlyph.renamed">
        <Setter Property="Foreground" Value="{DynamicResource StatusRenamed}" />
    </Style>

    <!-- ===================== Diff rows ===================== -->

    <Style Selector="Border.diffRow">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.diffRow.add">
        <Setter Property="Background" Value="{DynamicResource DiffAddBackground}" />
    </Style>
    <Style Selector="Border.diffRow.remove">
        <Setter Property="Background" Value="{DynamicResource DiffRemoveBackground}" />
    </Style>
    <Style Selector="Border.diffRow.hunk">
        <Setter Property="Background" Value="{DynamicResource DiffHunkBackground}" />
    </Style>

    <Style Selector="Border.diffGutter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.diffGutter.add">
        <Setter Property="Background" Value="{DynamicResource DiffAddGutter}" />
    </Style>
    <Style Selector="Border.diffGutter.remove">
        <Setter Property="Background" Value="{DynamicResource DiffRemoveGutter}" />
    </Style>
    <Style Selector="Border.diffGutter.hunk">
        <Setter Property="Background" Value="{DynamicResource DiffHunkBackground}" />
    </Style>

    <Style Selector="TextBlock.diffText">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource DiffCodeText}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="TextBlock.diffText.add">
        <Setter Property="Foreground" Value="{DynamicResource DiffAddText}" />
    </Style>
    <Style Selector="TextBlock.diffText.remove">
        <Setter Property="Foreground" Value="{DynamicResource DiffRemoveText}" />
    </Style>
    <Style Selector="TextBlock.diffText.hunk">
        <Setter Property="Foreground" Value="{DynamicResource DiffHunkText}" />
    </Style>

    <Style Selector="TextBlock.diffNumber">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource DiffGutterText}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Width" Value="34" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- ===================== Lists ===================== -->

    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
    </Style>

    <!-- Separator -->
    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- ===================== Activity console ===================== -->

    <Style Selector="Button.consoleBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Deliberately no :pointerover background. The bar spans the whole window, so
         lighting it up on hover reads as a flash rather than as feedback. The hand
         cursor is enough to say it is clickable. -->

    <!-- Drag handle between resizable panes. Reads as the divider it replaces until
         you approach it, so the layout doesn't gain a visible seam. -->
    <Style Selector="GridSplitter.paneSplitter">
        <Setter Property="Width" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Width="1" HorizontalAlignment="Center"
                            Background="{DynamicResource BorderSubtle}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="GridSplitter.paneSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Horizontal twin of the above, for dragging the activity console taller. -->
    <Style Selector="GridSplitter.consoleSplitter">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="GridSplitter.consoleSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Severity dot on the collapsed bar. -->
    <Style Selector="Border.logDot">
        <Setter Property="Background" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Border.logDot.trace">
        <Setter Property="Background" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Border.logDot.success">
        <Setter Property="Background" Value="{DynamicResource StatusAdded}" />
    </Style>
    <Style Selector="Border.logDot.warning">
        <Setter Property="Background" Value="{DynamicResource StatusModified}" />
    </Style>
    <Style Selector="Border.logDot.error">
        <Setter Property="Background" Value="{DynamicResource StatusDeleted}" />
    </Style>

    <Style Selector="TextBlock.logLine">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.logLine.trace">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.logLine.success">
        <Setter Property="Foreground" Value="{DynamicResource StatusAdded}" />
    </Style>
    <Style Selector="TextBlock.logLine.warning">
        <Setter Property="Foreground" Value="{DynamicResource StatusModified}" />
    </Style>
    <Style Selector="TextBlock.logLine.error">
        <Setter Property="Foreground" Value="{DynamicResource StatusDeleted}" />
    </Style>

    <!-- Dropdown surface for the repository and branch pickers. -->
    <Style Selector="FlyoutPresenter.picker">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MaxHeight" Value="540" />
    </Style>

    <!--
        Context menus. MenuFlyout renders through stock MenuFlyoutPresenter and MenuItem,
        which read FluentAvalonia's own palette rather than Tokens.axaml - so the
        right-click menus came up in a theme of their own next to the pickers, which have
        a FlyoutPresenter.picker style below. Part names are FluentAvalonia's template,
        read off the running theme rather than guessed at through resource keys.
    -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- The header presenter carries its own Foreground from the stock theme, so setting
         it on the MenuItem alone leaves the text the colour it already was. -->
    <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter Separator">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Stroked 16x16 icons. Override Stroke per-usage where more contrast is wanted. -->
    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- The panel inside a scrim. Every question the app stops to ask is this shape, so
         the width and the padding are set once here rather than at each call site. -->
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Width" Value="480" />
    </Style>

</Styles>
