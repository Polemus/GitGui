<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Omnigit.ViewModels"
             xmlns:m="using:Omnigit.Models"
             xmlns:views="using:Omnigit.Views"
             xmlns:conv="using:Omnigit.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="Omnigit.Views.RepositoryView"
             x:Name="SidebarRoot"
             x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Two-way: the splitter writes the new width back to the view model,
                 which is also what the toolbar wordmark measures itself against. -->
            <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}"
                              MinWidth="260" MaxWidth="620" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ======================= Sidebar ======================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                <!-- Current repository. Expands in place rather than into a flyout, so
                     the list appears where the repositories are rather than floating
                     over the tabs, and the tabs move down out of its way. -->
                <Button Grid.Row="0" Classes="repoPicker"
                        Command="{Binding ToggleRepositoryPickerCommand}">
                    <!-- No host badge: the hosting site is named on the line above, which
                         is what a coloured square was standing in for. "Current
                         repository" is gone with it - the chevron and the position at the
                         top of the sidebar say that already, and the line is worth more
                         carrying the owner and the site the clone came from. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Classes="muted" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedRepository.OriginLabel}" />
                            <TextBlock Classes="body" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedRepository.Name}" />
                        </StackPanel>

                        <!-- Points down closed, up open. Two Paths rather than a rotation
                             so there is no transform to animate or get stuck. -->
                        <Path Grid.Column="1" Classes="icon"
                              Data="{DynamicResource IconChevronDown}"
                              IsVisible="{Binding !IsRepositoryPickerOpen}" />
                        <Path Grid.Column="1" Classes="icon"
                              Data="{DynamicResource IconChevronDown}"
                              RenderTransformOrigin="50%,50%"
                              RenderTransform="rotate(180deg)"
                              IsVisible="{Binding IsRepositoryPickerOpen}" />
                    </Grid>
                </Button>

                <!-- The expanded list. Capped and scrollable: a long list must not push
                     the tabs and the commit box off the bottom of the sidebar. -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}"
                        IsVisible="{Binding IsRepositoryPickerOpen}">
                    <Grid RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" Classes="divider" />

                        <TextBlock Grid.Row="1" Classes="caption" Margin="14,10"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasRepositories}"
                                   Text="No repositories yet. Use + in the header to add or clone one." />

                        <ScrollViewer Grid.Row="1" MaxHeight="320" Padding="0,4,0,8"
                                      IsVisible="{Binding HasRepositories}">
                            <ItemsControl ItemsSource="{Binding RepositoryGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HostGroupViewModel">
                                        <StackPanel Margin="0,0,0,6">

                                            <!-- Host group header. Deliberately not shaped
                                                 like the rows beneath it: a badge the same
                                                 size as a row's icon made a single-repo
                                                 group read as two repositories. -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        Margin="14,6,10,4">
                                                <TextBlock Classes="groupLabel"
                                                           Text="{Binding Header}" />
                                                <TextBlock Classes="groupLabel"
                                                           Text="{Binding SubHeader}" />
                                            </StackPanel>

                                            <!-- Repositories on this host. No Click handler
                                                 now: there is no popup to dismiss, so the
                                                 CommandParameter cannot be torn down under
                                                 the command. -->
                                            <ItemsControl ItemsSource="{Binding Repositories}"
                                                          Margin="14,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="m:RepositoryInfo">
                                                        <Button Classes="rowButton"
                                                                Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).SelectRepositoryCommand}"
                                                                CommandParameter="{Binding}">

                                                            <!-- ContextFlyout, not ContextMenu:
                                                                 the latter draws nothing at all
                                                                 in Avalonia 12, which is how the
                                                                 changed-file list below does it
                                                                 too. Removing from the list needs
                                                                 no confirmation - the clone stays
                                                                 and re-adding is one folder
                                                                 picker. Deleting does, hence the
                                                                 ellipsis. -->
                                                            <Button.ContextFlyout>
                                                                <MenuFlyout Placement="Pointer">
                                                                    <MenuItem Header="Remove from Omnigit"
                                                                              Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).RemoveRepositoryCommand}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="Remove from this computer…"
                                                                              Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).AskDeleteRepositoryCommand}"
                                                                              CommandParameter="{Binding}" />
                                                                    <Separator />
                                                                    <MenuItem Header="Show in file manager"
                                                                              Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).ShowRepositoryInFileManagerCommand}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="Copy path"
                                                                              Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).CopyRepositoryPathCommand}"
                                                                              CommandParameter="{Binding}" />
                                                                </MenuFlyout>
                                                            </Button.ContextFlyout>

                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                                <Path Grid.Column="0" Classes="icon"
                                                                      Data="{DynamicResource IconRepo}" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Classes="body"
                                                                               Text="{Binding Name}" />
                                                                    <TextBlock Classes="muted"
                                                                               Text="{Binding FullName}" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Classes="chip"
                                                                        IsVisible="{Binding HasVisibility}">
                                                                    <TextBlock Classes="muted"
                                                                               Text="{Binding VisibilityLabel}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="divider" />

                <!-- Changes / History tabs -->
                <Grid Grid.Row="3" ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Classes="tab"
                            Classes.active="{Binding IsChangesTab}"
                            Command="{Binding ShowChangesTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <TextBlock Text="Changes" />
                            <Border Classes="chip" Padding="6,1">
                                <TextBlock Classes="muted" Text="{Binding Changes.Count}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="tab"
                            Classes.active="{Binding IsHistoryTab}"
                            Command="{Binding ShowHistoryTabCommand}"
                            Content="History" />
                </Grid>

                <Border Grid.Row="4" Classes="divider" />

                <!-- Tab body -->
                <Panel Grid.Row="5">

                    <!-- Working-tree changes -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding IsChangesTab}">

                        <!-- Not on a branch. Sits above everything else on the tab because
                             it changes what committing here even means. -->
                        <Border Grid.Row="0" Margin="14,10,14,0"
                                Background="{DynamicResource BannerInfoBackground}"
                                BorderBrush="{DynamicResource BannerInfoBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="11,9"
                                IsVisible="{Binding IsDetachedHead}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="You are looking at one commit rather than a branch. Anything committed here belongs to no branch, and is easy to lose track of." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Padding="9,4" FontSize="12"
                                            Content="Make a branch here"
                                            Command="{Binding BranchFromHereCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- A merge, revert or cherry-pick git stopped part-way through.
                             Everything needed to finish or abandon it is in this one
                             panel, next to the files it is talking about. -->
                        <Border Grid.Row="1" Margin="14,10,14,0"
                                Background="{DynamicResource BannerWarningBackground}"
                                BorderBrush="{DynamicResource BannerWarningBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="11,9"
                                IsVisible="{Binding HasPendingOperation}">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="caption" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="{Binding PendingOperationLabel}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding HasConflicts}"
                                           Text="{Binding ConflictHelpLabel}" />

                                <!-- Capped: a merge can leave dozens of files, and the
                                     panel must not push the change list off the sidebar. -->
                                <ScrollViewer MaxHeight="260" IsVisible="{Binding HasConflicts}">
                                    <ItemsControl ItemsSource="{Binding ConflictedPaths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <StackPanel Spacing="4" Margin="0,4">
                                                    <TextBlock Classes="body" Text="{Binding}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="secondary" Padding="8,3" FontSize="12"
                                                                Content="Keep mine"
                                                                Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).KeepMineCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="secondary" Padding="8,3" FontSize="12"
                                                                Content="Take theirs"
                                                                Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).KeepTheirsCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="secondary" Padding="8,3" FontSize="12"
                                                                Content="I fixed it"
                                                                Command="{Binding #SidebarRoot.((vm:MainWindowViewModel)DataContext).MarkResolvedCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Classes="secondary" Padding="9,4" FontSize="12"
                                        HorizontalAlignment="Left"
                                        Content="Abandon it"
                                        Command="{Binding AskAbortOperationCommand}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="9"
                              Margin="14,8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding AreAllStaged, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                                       Text="{Binding StagedCountLabel}" />
                        </Grid>

                        <Border Grid.Row="3" Classes="divider" />

                        <!-- Same right-click handling as the history list: select the row
                             under the pointer, then open the flyout ourselves. Selection
                             is Multiple so ctrl- and shift-click pick out a set of files
                             to discard in one go; SelectedItem stays the anchor row and is
                             what the diff pane shows. -->
                        <ListBox Grid.Row="4" Classes="plain"
                                 ItemsSource="{Binding Changes}"
                                 SelectionMode="Multiple"
                                 SelectedItem="{Binding SelectedChange, Mode=TwoWay}"
                                 SelectedItems="{Binding SelectedChanges}"
                                 ContextRequested="OnChangesContextRequested"
                                 PointerReleased="OnChangesPointerReleased"
                                 DoubleTapped="OnChangesDoubleTapped">
                            <ListBox.ContextFlyout>
                                <MenuFlyout Placement="Pointer">
                                    <MenuItem Header="{Binding DiscardChangesLabel}"
                                              Command="{Binding AskDiscardChangesCommand}" />
                                    <Separator />

                                    <!-- Everything below names one file, so it is offered
                                         only while one row is selected. Each ignore entry
                                         is offered only where it means something besides:
                                         no folder entry for a file at the root, no
                                         extension entry for a Makefile. -->
                                    <MenuItem Header="Ignore file (add to .gitignore)"
                                              IsVisible="{Binding IsOneChangeSelected}"
                                              Command="{Binding IgnoreCommand}"
                                              CommandParameter="{Binding SelectedChange.IgnoreFilePattern}" />
                                    <MenuItem Header="{Binding SelectedChange.IgnoreFolderLabel}"
                                              IsVisible="{Binding CanIgnoreFolder}"
                                              Command="{Binding IgnoreCommand}"
                                              CommandParameter="{Binding SelectedChange.IgnoreFolderPattern}" />
                                    <MenuItem Header="{Binding SelectedChange.IgnoreExtensionLabel}"
                                              IsVisible="{Binding CanIgnoreExtension}"
                                              Command="{Binding IgnoreCommand}"
                                              CommandParameter="{Binding SelectedChange.IgnoreExtensionPattern}" />
                                    <Separator IsVisible="{Binding IsOneChangeSelected}" />

                                    <!-- Same thing a double-click on the row does; here so
                                         it's discoverable, and so a keyboard-only
                                         selection can reach it. -->
                                    <MenuItem Header="Open in your default app"
                                              IsVisible="{Binding CanOpenSelectedChange}"
                                              Command="{Binding OpenChangeCommand}"
                                              CommandParameter="{Binding SelectedChange}" />
                                    <Separator IsVisible="{Binding CanOpenSelectedChange}" />

                                    <MenuItem Header="Copy file path"
                                              IsVisible="{Binding IsOneChangeSelected}"
                                              Command="{Binding CopyFilePathCommand}"
                                              CommandParameter="{Binding SelectedChange}" />
                                    <MenuItem Header="Copy relative file path"
                                              IsVisible="{Binding IsOneChangeSelected}"
                                              Command="{Binding CopyRelativeFilePathCommand}"
                                              CommandParameter="{Binding SelectedChange}" />
                                    <Separator IsVisible="{Binding IsOneChangeSelected}" />

                                    <MenuItem Header="Show in your file manager"
                                              IsVisible="{Binding IsOneChangeSelected}"
                                              Command="{Binding ShowInFileManagerCommand}"
                                              CommandParameter="{Binding SelectedChange}" />
                                </MenuFlyout>
                            </ListBox.ContextFlyout>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileChangeViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9"
                                          Margin="14,4">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsStaged, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="body" Text="{Binding FileName}" />
                                            <TextBlock Classes="muted" Text="{Binding Directory}"
                                                       IsVisible="{Binding HasDirectory}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <TextBlock Classes="muted"
                                                       Foreground="{DynamicResource StatusAdded}"
                                                       Text="{Binding AdditionsLabel}" />
                                            <TextBlock Classes="muted"
                                                       Foreground="{DynamicResource StatusDeleted}"
                                                       Text="{Binding DeletionsLabel}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Classes="statusGlyph"
                                                   Classes.added="{Binding IsAdded}"
                                                   Classes.modified="{Binding IsModified}"
                                                   Classes.deleted="{Binding IsDeleted}"
                                                   Classes.renamed="{Binding IsRenamed}"
                                                   Text="{Binding StatusGlyph}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Commit history. The right-click handler selects the row under the
                         pointer first, which Avalonia does not do by itself - the menu's
                         commands then act on SelectedCommit rather than on a
                         CommandParameter that goes null as the popup closes. -->
                    <ListBox Classes="plain"
                             IsVisible="{Binding IsHistoryTab}"
                             ItemsSource="{Binding History}"
                             SelectedItem="{Binding SelectedCommit, Mode=TwoWay}"
                             ContextRequested="OnHistoryContextRequested"
                             PointerReleased="OnHistoryPointerReleased">
                        <!-- Entries stay put and grey out rather than disappearing: a menu
                             whose shape changes per row is one you have to read every
                             time. Each command decides for itself whether it applies. -->
                        <ListBox.ContextFlyout>
                            <MenuFlyout Placement="Pointer">
                                <MenuItem Header="Amend this commit…"
                                          Command="{Binding AmendSelectedCommitCommand}" />
                                <MenuItem Header="Reset the branch to here…"
                                          Command="{Binding ResetToSelectedCommitCommand}" />
                                <MenuItem Header="Open this commit"
                                          Command="{Binding CheckoutSelectedCommitCommand}" />
                                <MenuItem Header="Undo this commit"
                                          Command="{Binding RevertSelectedCommitCommand}" />
                                <Separator />

                                <MenuItem Header="Create a branch from here…"
                                          Command="{Binding BranchFromSelectedCommitCommand}" />
                                <MenuItem Header="Create a tag…"
                                          Command="{Binding TagSelectedCommitCommand}" />
                                <MenuItem Header="Copy onto another branch…"
                                          Command="{Binding CherryPickSelectedCommitCommand}" />
                                <Separator />

                                <MenuItem Header="Copy SHA"
                                          Command="{Binding CopyCommitShaCommand}" />
                                <MenuItem Header="Copy summary"
                                          Command="{Binding CopyCommitSummaryCommand}" />
                                <MenuItem Header="Copy tag"
                                          Command="{Binding CopyCommitTagCommand}" />
                                <Separator />

                                <MenuItem Header="{Binding ViewOnHostLabel}"
                                          Command="{Binding ViewCommitOnHostCommand}" />
                            </MenuFlyout>
                        </ListBox.ContextFlyout>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:CommitInfo">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="14,7">
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                            VerticalAlignment="Top"
                                            Background="{Binding AvatarHex, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding AuthorInitials}"
                                                   FontSize="11" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <!-- Badges keep their width; the summary gives way,
                                             since a tag is the thing being scanned for. -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBlock Grid.Column="0" Classes="body" Text="{Binding Summary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}"
                                                          IsVisible="{Binding HasTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Classes="tagBadge">
                                                            <TextBlock Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="muted" Text="{Binding AuthorName}" />
                                            <TextBlock Classes="muted" Text="·" />
                                            <TextBlock Classes="muted" Text="{Binding RelativeTime}" />
                                            <TextBlock Classes="muted" FontFamily="{DynamicResource MonoFont}"
                                                       Text="{Binding ShortSha}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>

                <!-- Commit box (Changes tab only) -->
                <StackPanel Grid.Row="6" Spacing="9" Margin="14"
                            IsVisible="{Binding IsChangesTab}">
                    <Border Classes="divider" Margin="-14,0,-14,4" />

                    <!-- Stashed work waiting on this branch. Sits above the message boxes
                         so it is seen before anything new is written. -->
                    <Border Background="{DynamicResource BannerInfoBackground}"
                            BorderBrush="{DynamicResource BannerInfoBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="11,9"
                            IsVisible="{Binding HasBranchStashes}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="{Binding StashLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary" Padding="9,4" FontSize="12"
                                        Content="Restore"
                                        Command="{Binding RestoreStashCommand}" />
                                <Button Classes="secondary" Padding="9,4" FontSize="12"
                                        Content="Discard"
                                        Command="{Binding DiscardStashCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBox Classes="commitBox"
                             PlaceholderText="{Binding CommitSummaryPlaceholder}"
                             Text="{Binding CommitSummary, Mode=TwoWay}" />
                    <TextBox Classes="commitBox"
                             PlaceholderText="Description"
                             Text="{Binding CommitDescription, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="76" />
                    <!-- Amending is started from the history's context menu. While it is
                         on, the bar below says so and offers the way out; the commit
                         button relabels itself. -->
                    <Border Background="{DynamicResource BannerInfoBackground}"
                            BorderBrush="{DynamicResource BannerInfoBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="11,9"
                            IsVisible="{Binding IsAmending}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="caption" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="Fixing the last commit instead of adding a new one." />
                            <Button Grid.Column="1" Classes="secondary" Padding="9,4" FontSize="12"
                                    Content="Cancel"
                                    Command="{Binding CancelAmendCommand}" />
                        </Grid>
                    </Border>

                    <Button Classes="primary" HorizontalAlignment="Stretch"
                            Command="{Binding CommitCommand}"
                            Content="{Binding CommitButtonLabel}" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Classes="paneSplitter" />

        <!-- ======================= Detail pane ======================= -->
        <Panel Grid.Column="2" Background="{DynamicResource AppBackground}">

            <!-- Selected working-tree file. No outer ScrollViewer: DiffView fills the
                 pane and scrolls itself, so its scrollbars sit at the pane's edges. -->
            <ContentControl IsVisible="{Binding IsChangesTab}" Margin="18"
                            Content="{Binding SelectedChange}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:FileChangeViewModel">
                        <views:DiffView DataContext="{Binding Model}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Clean working tree -->
            <TextBlock IsVisible="{Binding IsChangesTab}"
                       Classes="caption"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="No local changes."
                       ZIndex="-1" />

            <!-- Selected commit: header across the top, then files | splitter | diff. -->
            <Grid IsVisible="{Binding IsHistoryTab}" RowDefinitions="Auto,*">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding CommitFilesWidth, Mode=TwoWay}"
                                      MinWidth="180" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- A ContentControl, not a Border with IsVisible: the template isn't
                     realised until SelectedCommit is non-null, so nothing binds against
                     a null commit and the debug console stays quiet. -->
                <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                Margin="18,18,18,0"
                                Content="{Binding SelectedCommit}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="m:CommitInfo">
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                VerticalAlignment="Top"
                                                Background="{Binding AvatarHex, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding AuthorInitials}"
                                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Classes="h2" Text="{Binding Summary}"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Tags}"
                                                          IsVisible="{Binding HasTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemSpacing="4"
                                                                   LineSpacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Classes="tagBadge">
                                                            <TextBlock Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Classes="caption" Text="{Binding AuthorName}" />
                                                <TextBlock Classes="muted" Text="committed" />
                                                <TextBlock Classes="muted" Text="{Binding RelativeTime}" />
                                                <TextBlock Classes="muted" Text="·" />
                                                <!-- Lives on the view model, not the commit, so it
                                                     reaches back out of the template. -->
                                                <TextBlock Classes="muted"
                                                           Text="{Binding $parent[views:RepositoryView].((vm:MainWindowViewModel)DataContext).SelectedCommitFilesLabel}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Classes="chip" VerticalAlignment="Top">
                                            <TextBlock Classes="mono" Foreground="{DynamicResource TextSecondary}"
                                                       Text="{Binding ShortSha}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                <!-- Files in this commit. Clicking one shows its diff on the right. -->
                <ListBox Grid.Row="1" Grid.Column="0" Classes="plain" Margin="0,12,0,0"
                         ItemsSource="{Binding SelectedCommitFiles}"
                         SelectedItem="{Binding SelectedCommitFile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:FileChange">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"
                                  Margin="18,7,10,7">
                                <TextBlock Grid.Column="0"
                                           Classes="statusGlyph"
                                           Classes.added="{Binding IsAdded}"
                                           Classes.modified="{Binding IsModified}"
                                           Classes.deleted="{Binding IsDeleted}"
                                           Classes.renamed="{Binding IsRenamed}"
                                           Text="{Binding StatusGlyph}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="body" Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted" Text="{Binding Directory}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Directory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="muted"
                                               Foreground="{DynamicResource StatusAdded}"
                                               Text="{Binding Additions, StringFormat='+{0}'}" />
                                    <TextBlock Classes="muted"
                                               Foreground="{DynamicResource StatusDeleted}"
                                               Text="{Binding Deletions, StringFormat='-{0}'}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1" Grid.Column="1" Classes="paneSplitter" />

                <ContentControl Grid.Row="1" Grid.Column="2" Margin="18,12,18,18"
                                Content="{Binding SelectedCommitFile}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="m:FileChange">
                            <views:DiffView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
