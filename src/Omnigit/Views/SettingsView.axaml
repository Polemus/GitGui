<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Omnigit.ViewModels"
             xmlns:hp="using:Omnigit.HostProviders"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="Omnigit.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             x:Name="Root">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="220,Auto,*" Background="{DynamicResource AppBackground}">

        <!-- ===================== Section rail ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <StackPanel Margin="0,18,0,0" Spacing="3">
                <Button Classes="secondary" Margin="14,0,14,16"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ShowRepositoryCommand}"
                        Content="← Back to repository" />

                <TextBlock Classes="sectionLabel" Text="SETTINGS" Margin="18,0,18,8" />

                <Button Classes="settingsTab" Content="Accounts"
                        Classes.active="{Binding IsAccountsSection}"
                        Command="{Binding ShowSettingsSectionCommand}">
                    <Button.CommandParameter>
                        <x:Int32>0</x:Int32>
                    </Button.CommandParameter>
                </Button>

                <Button Classes="settingsTab" Content="Hosting sites"
                        Classes.active="{Binding IsHostsSection}"
                        Command="{Binding ShowSettingsSectionCommand}">
                    <Button.CommandParameter>
                        <x:Int32>1</x:Int32>
                    </Button.CommandParameter>
                </Button>

                <!-- The dot is inside the tab rather than beside it because the rail
                     stretches its buttons; a sibling would sit at the far edge of a
                     220-pixel column, three inches from the word it is about. -->
                <Button Classes="settingsTab"
                        Classes.active="{Binding IsAboutSection}"
                        Command="{Binding ShowSettingsSectionCommand}">
                    <Button.CommandParameter>
                        <x:Int32>2</x:Int32>
                    </Button.CommandParameter>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="About" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{DynamicResource NotificationDot}"
                                 IsVisible="{Binding Update.IsUpdateAvailable}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSubtle}" />

        <Panel Grid.Column="2">

            <!-- ===================== Accounts ===================== -->
            <ScrollViewer IsVisible="{Binding IsAccountsSection}">
                <StackPanel MaxWidth="880" Margin="32,28,32,48" Spacing="22"
                            HorizontalAlignment="Left">

                    <StackPanel Spacing="8">
                        <TextBlock Classes="h1" Text="Accounts" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Omnigit talks to any number of hosting sites at once. Each keeps its own credentials, so a self-hosted Gitea behind your own domain works exactly like GitHub.com." />
                    </StackPanel>

                    <!-- Where tokens live -->
                    <Border Background="{DynamicResource ElevatedBackground}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="8" Padding="14,11">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="{Binding CredentialBackendLabel}" />
                        </StackPanel>
                    </Border>

                    <!-- Weak-storage warning, only when no keyring was found -->
                    <Border Background="{DynamicResource BannerErrorBackground}"
                            BorderBrush="{DynamicResource BannerErrorBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14,11"
                            IsVisible="{Binding CredentialBackendIsWeak}">
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="No system keyring was found, so tokens are written to a file readable by anything running as you. Install libsecret (secret-tool) for encrypted storage." />
                    </Border>

                    <!-- Signed-in accounts -->
                    <StackPanel Spacing="12">
                        <TextBlock Classes="sectionLabel" Text="SIGNED IN" />

                        <TextBlock Classes="caption" IsVisible="{Binding !HasAccounts}"
                                   Text="No accounts yet. Sign in below to fetch and push." />

                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="hp:HostAccount">
                                    <Border Classes="card" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource AccentBrush}">
                                                <TextBlock Text="{Binding Login[0]}"
                                                           FontSize="17" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Classes="h2" Text="{Binding DisplayName}" />
                                                    <TextBlock Classes="caption" VerticalAlignment="Center"
                                                               Text="{Binding Handle}" />
                                                </StackPanel>
                                                <TextBlock Classes="muted" FontFamily="{DynamicResource MonoFont}"
                                                           Text="{Binding BaseUrl}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Classes="secondary" Content="Sign out"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).SignOutCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sign in -->
                    <StackPanel Spacing="12">
                        <TextBlock Classes="sectionLabel" Text="ADD AN ACCOUNT" />
                        <Border Classes="card">
                            <StackPanel Spacing="14">

                                <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Classes="muted" Text="Site" />
                                        <ComboBox ItemsSource="{Binding Providers}"
                                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="hp:IHostProvider">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Classes="muted" Text="Server URL" />
                                        <TextBox Classes="commitBox"
                                                 Text="{Binding SignInServerUrl, Mode=TwoWay}"
                                                 PlaceholderText="https://git.example.com" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="Personal access token" />
                                    <TextBox Classes="commitBox"
                                             PasswordChar="•"
                                             Text="{Binding SignInToken, Mode=TwoWay}"
                                             PlaceholderText="Paste your token" />
                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                               Text="{Binding TokenHelpText}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="primary" Content="Sign in"
                                            Command="{Binding SignInWithTokenCommand}" />
                                    <Button Classes="secondary" Content="Sign in with browser"
                                            IsVisible="{Binding CanUseBrowserLogin}"
                                            Command="{Binding StartBrowserLoginCommand}" />
                                </StackPanel>

                                <!-- Device code, shown while a browser login is pending. A
                                     ContentControl, not IsVisible: the template isn't realised until
                                     there is a login, so nothing binds against null. -->
                                <ContentControl Content="{Binding PendingDeviceLogin}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="hp:DeviceLogin">
                                            <Border Background="{DynamicResource BannerInfoBackground}"
                                                    BorderBrush="{DynamicResource BannerInfoBorder}"
                                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Classes="caption"
                                                               Text="Your browser should have opened with the code already copied. If not:" />
                                                    <!-- FontFamily is set here, not by the mono class: Avalonia
                                                         selectors match the exact type, so TextBlock.mono
                                                         reaches neither a Button nor a SelectableTextBlock. -->
                                                    <Button Classes="link" HorizontalAlignment="Left"
                                                            FontFamily="{DynamicResource MonoFont}"
                                                            Content="{Binding VerificationUri}"
                                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).OpenDeviceUrlCommand}"
                                                            ToolTip.Tip="Open this page in your browser" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                                VerticalAlignment="Center">
                                                        <!-- Selectable so the code can be dragged out even if
                                                             the clipboard is unreachable. -->
                                                        <SelectableTextBlock FontFamily="{DynamicResource MonoFont}"
                                                                             FontSize="26" FontWeight="Bold"
                                                                             Foreground="{DynamicResource AccentBrush}"
                                                                             VerticalAlignment="Center"
                                                                             Text="{Binding UserCode}" />
                                                        <Button Classes="secondary" Content="Copy code"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CopyDeviceCodeCommand}" />
                                                    </StackPanel>
                                                    <TextBlock Classes="muted" Text="Waiting for approval…" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Hosting sites ===================== -->
            <ScrollViewer IsVisible="{Binding IsHostsSection}">
                <StackPanel MaxWidth="880" Margin="32,28,32,48" Spacing="22"
                            HorizontalAlignment="Left">

                    <StackPanel Spacing="8">
                        <TextBlock Classes="h1" Text="Hosting sites" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="A hosting site is described by data, never by code, so a description you got from someone else can never read the tokens held for your other sites. Adding one here writes exactly the same JSON file you could drop in the hosts folder yourself." />
                    </StackPanel>

                    <!-- Manifest problems -->
                    <Border Background="{DynamicResource BannerErrorBackground}"
                            BorderBrush="{DynamicResource BannerErrorBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14,11"
                            IsVisible="{Binding HasHostWarnings}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" FontWeight="SemiBold" Text="Host description problems" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding HostWarnings}" />
                        </StackPanel>
                    </Border>

                    <!-- Known sites -->
                    <StackPanel Spacing="12">
                        <TextBlock Classes="sectionLabel" Text="KNOWN SITES" />

                        <ItemsControl ItemsSource="{Binding HostEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HostEntryViewModel">
                                    <Border Classes="card" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Classes="h2" Text="{Binding DisplayName}" />
                                                    <Border Classes="chip" VerticalAlignment="Center">
                                                        <TextBlock Classes="muted" Text="{Binding SourceLabel}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Classes="muted"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               Text="{Binding Id}" />
                                                    <TextBlock Classes="muted" Text="·" />
                                                    <TextBlock Classes="muted" Text="{Binding AuthLabel}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1" Classes="secondary" Content="Edit"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsUserDefined}"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).EditHostCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="2" Classes="secondary" Content="Remove"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsUserDefined}"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).DeleteHostCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    IsVisible="{Binding !IsEditingHost}">
                            <Button Classes="primary" Content="Add a site"
                                    Command="{Binding AddHostCommand}" />
                            <Button Classes="secondary" Content="Add a GitLab-like site"
                                    Command="{Binding AddGitLabLikeHostCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Add / edit form. Not realised until there is a draft. -->
                    <ContentControl Content="{Binding HostDraft}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:HostDraftViewModel">
                                <Border Classes="card">
                                    <StackPanel Spacing="16">
                                        <TextBlock Classes="h2" Text="{Binding Title}" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <TextBlock Classes="muted" Text="Id" />
                                                <TextBox Classes="commitBox" Text="{Binding Id, Mode=TwoWay}"
                                                         IsEnabled="{Binding !IsEditing}"
                                                         PlaceholderText="forgejo" />
                                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                                           Text="Lower case, no spaces. Names the file, and replaces a built-in site if it matches one." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Classes="muted" Text="Display name" />
                                                <TextBox Classes="commitBox" Text="{Binding DisplayName, Mode=TwoWay}"
                                                         PlaceholderText="Forgejo" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="sectionLabel" Text="RECOGNISING THE SITE" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                                       Text="Omnigit probes this path and checks the field exists, rather than guessing from the domain name." />
                                            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                                                <TextBox Grid.Column="0" Classes="commitBox"
                                                         Text="{Binding RecognisePath, Mode=TwoWay}"
                                                         PlaceholderText="/api/v1/version" />
                                                <TextBox Grid.Column="1" Classes="commitBox"
                                                         Text="{Binding RecogniseField, Mode=TwoWay}"
                                                         PlaceholderText="version" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="sectionLabel" Text="TOKEN HEADER" />
                                            <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                                                <TextBox Grid.Column="0" Classes="commitBox"
                                                         Text="{Binding AuthHeaderName, Mode=TwoWay}"
                                                         PlaceholderText="Authorization" />
                                                <TextBox Grid.Column="1" Classes="commitBox"
                                                         Text="{Binding AuthHeaderValue, Mode=TwoWay}"
                                                         PlaceholderText="token {token}" />
                                            </Grid>
                                            <TextBlock Classes="muted"
                                                       Text="{}{token} is replaced with the signed-in account's token." />
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="sectionLabel" Text="ENDPOINTS" />
                                            <TextBox Classes="commitBox"
                                                     Text="{Binding CurrentUserEndpoint, Mode=TwoWay}"
                                                     PlaceholderText="/api/v1/user" />
                                            <TextBox Classes="commitBox"
                                                     Text="{Binding RepositoriesEndpoint, Mode=TwoWay}"
                                                     PlaceholderText="/api/v1/user/repos?limit=100" />
                                            <TextBox Classes="commitBox"
                                                     Text="{Binding PullRequestsEndpoint, Mode=TwoWay}"
                                                     PlaceholderText="{}{owner}/{repo} pull requests — leave empty if the site has none" />
                                        </StackPanel>

                                        <Expander Header="Where the values sit in the responses">
                                            <StackPanel Spacing="14" Margin="0,10,0,0">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" Text="Account: login, display name, avatar" />
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" Classes="commitBox"
                                                                 Text="{Binding UserLoginField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" Classes="commitBox"
                                                                 Text="{Binding UserDisplayNameField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="2" Classes="commitBox"
                                                                 Text="{Binding UserAvatarField, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" Text="Repository: name, owner, clone URL, default branch" />
                                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" Classes="commitBox"
                                                                 Text="{Binding RepoNameField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" Classes="commitBox"
                                                                 Text="{Binding RepoOwnerField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="2" Classes="commitBox"
                                                                 Text="{Binding RepoCloneUrlField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="3" Classes="commitBox"
                                                                 Text="{Binding RepoDefaultBranchField, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" Text="Repository: description, updated at" />
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" Classes="commitBox"
                                                                 Text="{Binding RepoDescriptionField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" Classes="commitBox"
                                                                 Text="{Binding RepoUpdatedAtField, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                                               Text="Private repositories: the field, and — only if the site sends a word rather than true/false — the word that means private." />
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" Classes="commitBox"
                                                                 Text="{Binding RepoPrivateField, Mode=TwoWay}"
                                                                 PlaceholderText="private" />
                                                        <TextBox Grid.Column="1" Classes="commitBox"
                                                                 Text="{Binding RepoPrivateEquals, Mode=TwoWay}"
                                                                 PlaceholderText="(leave empty for true/false)" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" Text="Pull request: number, title, author, draft" />
                                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" Classes="commitBox"
                                                                 Text="{Binding PrNumberField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" Classes="commitBox"
                                                                 Text="{Binding PrTitleField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="2" Classes="commitBox"
                                                                 Text="{Binding PrAuthorField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="3" Classes="commitBox"
                                                                 Text="{Binding PrDraftField, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" Text="Pull request: source branch, target branch, updated at, page URL" />
                                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" Classes="commitBox"
                                                                 Text="{Binding PrSourceBranchField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" Classes="commitBox"
                                                                 Text="{Binding PrTargetBranchField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="2" Classes="commitBox"
                                                                 Text="{Binding PrUpdatedAtField, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="3" Classes="commitBox"
                                                                 Text="{Binding PrWebUrlField, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                                               Text="Checking a pull request out fetches this ref from the remote, so a contributor's fork needs no remote of its own." />
                                                    <TextBox Classes="commitBox"
                                                             Text="{Binding PullRequestRef, Mode=TwoWay}"
                                                             PlaceholderText="refs/pull/{}{number}/head" />
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" Text="What git gets for HTTPS: username, password" />
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" Classes="commitBox"
                                                                 Text="{Binding GitUsername, Mode=TwoWay}" />
                                                        <TextBox Grid.Column="1" Classes="commitBox"
                                                                 Text="{Binding GitPassword, Mode=TwoWay}" />
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                                               Text="Where &quot;View on this site&quot; sends a browser. Leave it alone unless the site puts its commits somewhere unusual." />
                                                    <TextBox Classes="commitBox"
                                                             Text="{Binding CommitUrlTemplate, Mode=TwoWay}"
                                                             PlaceholderText="{}{base}/{owner}/{repo}/commit/{sha}" />
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                                               Text="Where &quot;Create pull request&quot; sends a browser. Opening one is left to the site's own form, which asks for reviewers and templates this app knows nothing about." />
                                                    <TextBox Classes="commitBox"
                                                             Text="{Binding NewPullRequestUrlTemplate, Mode=TwoWay}"
                                                             PlaceholderText="{}{base}/{owner}/{repo}/compare/{target}...{source}?expand=1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>

                                        <!-- Testing the draft against a real server, before saving it. -->
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="sectionLabel" Text="TEST IT AGAINST A SERVER" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                                       Text="Neither the address nor the token is saved. Without a token only the recognise check can run." />
                                            <Grid ColumnDefinitions="2*,2*,Auto" ColumnSpacing="12">
                                                <TextBox Grid.Column="0" Classes="commitBox"
                                                         Text="{Binding TestUrl, Mode=TwoWay}"
                                                         PlaceholderText="https://git.example.com" />
                                                <TextBox Grid.Column="1" Classes="commitBox"
                                                         PasswordChar="•"
                                                         Text="{Binding TestToken, Mode=TwoWay}"
                                                         PlaceholderText="token (optional)" />
                                                <Button Grid.Column="2" Classes="secondary" Content="Test connection"
                                                        IsEnabled="{Binding CanTest}"
                                                        Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).TestHostCommand}" />
                                            </Grid>

                                            <TextBlock Classes="muted" Text="Testing…" IsVisible="{Binding IsTesting}" />

                                            <StackPanel Spacing="10" IsVisible="{Binding HasTestResult}">
                                                <TextBlock Classes="logLine"
                                                           Classes.success="{Binding TestPassed}"
                                                           Classes.error="{Binding !TestPassed}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding TestSummary}" />
                                                <ItemsControl ItemsSource="{Binding TestSteps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ProbeStepViewModel">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                                                  Margin="0,0,0,8">
                                                                <TextBlock Grid.Column="0" Classes="statusGlyph"
                                                                           Classes.added="{Binding IsPassed}"
                                                                           Classes.deleted="{Binding IsFailed}"
                                                                           Text="{Binding Glyph}" />
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock Classes="body" Text="{Binding Name}" />
                                                                    <TextBlock Classes="muted" TextWrapping="Wrap"
                                                                               Text="{Binding Detail}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Classes="primary" Content="Save site"
                                                    IsEnabled="{Binding CanSave}"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).SaveHostCommand}" />
                                            <Button Classes="secondary" Content="Cancel"
                                                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CancelHostDraftCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Sites added here are written to the hosts folder as JSON. You can still edit those files by hand — see docs/host-manifests.md." />
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== About ===================== -->
            <ScrollViewer IsVisible="{Binding IsAboutSection}">
                <StackPanel MaxWidth="880" Margin="32,28,32,48" Spacing="22"
                            HorizontalAlignment="Left">

                    <StackPanel Spacing="8">
                        <TextBlock Classes="h1" Text="About Omnigit" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="A git client that talks to more than one hosting site. MIT licensed." />
                    </StackPanel>

                    <!-- Through a template rather than by reassigning DataContext on a
                         panel: everything inside binds against the update view model, and
                         a template is the one place a compiled binding's x:DataType can
                         change without the enclosing scope having to change with it. -->
                    <ContentControl Content="{Binding Update}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:UpdateViewModel">
                                <Border Classes="card">
                                    <StackPanel Spacing="16">

                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="h2"
                                                       Text="{Binding CurrentVersion, StringFormat='Version {0}'}" />
                                            <TextBlock Classes="muted" Text="{Binding CurrentVersionDetail}" />
                                        </StackPanel>

                                        <!-- What the check found. Nothing has been asked
                                             before the first one, which is why this hides
                                             rather than showing a status of nothing. -->
                                        <TextBlock Classes="body" TextWrapping="Wrap"
                                                   Text="{Binding StatusLine}"
                                                   IsVisible="{Binding StatusLine,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                        <ProgressBar Minimum="0" Maximum="1" Height="4"
                                                     Value="{Binding Progress}"
                                                     IsVisible="{Binding IsWorking}" />

                                        <!-- What changed, as release.sh wrote it into the
                                             metainfo. Selectable because the first thing
                                             anyone does with a version is paste it. -->
                                        <Border Background="{DynamicResource BannerInfoBackground}"
                                                BorderBrush="{DynamicResource BannerInfoBorder}"
                                                BorderThickness="1" CornerRadius="8" Padding="14,11"
                                                IsVisible="{Binding HasNotes}">
                                            <SelectableTextBlock TextWrapping="Wrap"
                                                                 FontSize="13" LineHeight="18"
                                                                 Text="{Binding Notes}" />
                                        </Border>

                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BannerWarningBorder}"
                                                   Text="{Binding Detail}"
                                                   IsVisible="{Binding HasFailed}" />

                                        <!-- A Flatpak, a .deb and an .rpm each update
                                             themselves through something better than a
                                             button. Saying so beats a control that is
                                             disabled with no explanation. -->
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="{Binding ManagedBy}"
                                                   IsVisible="{Binding IsManagedElsewhere}" />

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Classes="primary" Content="Update now"
                                                    IsVisible="{Binding CanInstall}"
                                                    Command="{Binding InstallCommand}" />

                                            <Button Classes="secondary" Content="Check for updates"
                                                    IsVisible="{Binding !IsWorking}"
                                                    Command="{Binding CheckCommand}" />

                                            <Button Classes="link" Content="Release notes on GitHub"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsUpdateAvailable}"
                                                    Command="{Binding OpenReleasePageCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Omnigit checks for a new release once a day. Nothing is downloaded until you press Update now." />
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
