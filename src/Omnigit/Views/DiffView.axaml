<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Omnigit.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
             x:Class="Omnigit.Views.DiffView"
             x:DataType="m:FileChange">

    <!--  One file's unified diff, filling whatever pane it is given. It owns both
         scroll directions, so the scrollbars sit against the edges of the pane rather
         than against the end of the text. -->
    <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- File header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" Margin="13,10">
                <TextBlock Grid.Column="0"
                           Classes="statusGlyph"
                           Classes.added="{Binding IsAdded}"
                           Classes.modified="{Binding IsModified}"
                           Classes.deleted="{Binding IsDeleted}"
                           Classes.renamed="{Binding IsRenamed}"
                           Text="{Binding StatusGlyph}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Path}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Classes="mono" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusAdded}"
                               Text="{Binding Additions, StringFormat='+{0}'}" />
                    <TextBlock Classes="mono" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusDeleted}"
                               Text="{Binding Deletions, StringFormat='-{0}'}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Classes="divider" />

            <!-- Unified diff body -->
            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Diff}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:DiffLine">
                            <Border Classes="diffRow"
                                    Classes.add="{Binding IsAdded}"
                                    Classes.remove="{Binding IsRemoved}"
                                    Classes.hunk="{Binding IsHunkHeader}">
                                <Grid ColumnDefinitions="Auto,Auto,*">

                                    <!-- Line-number gutter -->
                                    <Border Grid.Column="0"
                                            Classes="diffGutter"
                                            Classes.add="{Binding IsAdded}"
                                            Classes.remove="{Binding IsRemoved}"
                                            Classes.hunk="{Binding IsHunkHeader}"
                                            Padding="9,2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="diffNumber" Text="{Binding OldNumber}" />
                                            <TextBlock Classes="diffNumber" Text="{Binding NewNumber}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- +/-/space marker -->
                                    <TextBlock Grid.Column="1"
                                               Classes="diffText"
                                               Classes.add="{Binding IsAdded}"
                                               Classes.remove="{Binding IsRemoved}"
                                               Classes.hunk="{Binding IsHunkHeader}"
                                               Text="{Binding Marker}"
                                               Width="17" TextAlignment="Center"
                                               Padding="0,2" />

                                    <!-- Code -->
                                    <TextBlock Grid.Column="2"
                                               Classes="diffText"
                                               Classes.add="{Binding IsAdded}"
                                               Classes.remove="{Binding IsRemoved}"
                                               Classes.hunk="{Binding IsHunkHeader}"
                                               Text="{Binding Text}"
                                               Padding="0,2,24,2" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
