<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGui.ViewModels"
             xmlns:m="using:GitGui.Models"
             xmlns:views="using:GitGui.Views"
             xmlns:conv="using:GitGui.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="GitGui.Views.RepositoryView"
             x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Two-way: the splitter writes the new width back to the view model,
                 which is also what the toolbar wordmark measures itself against. -->
            <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}"
                              MinWidth="260" MaxWidth="620" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ======================= Sidebar ======================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Changes / History tabs -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Classes="tab"
                            Classes.active="{Binding IsChangesTab}"
                            Command="{Binding ShowChangesTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <TextBlock Text="Changes" />
                            <Border Classes="chip" Padding="6,1">
                                <TextBlock Classes="muted" Text="{Binding Changes.Count}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="tab"
                            Classes.active="{Binding IsHistoryTab}"
                            Command="{Binding ShowHistoryTabCommand}"
                            Content="History" />
                </Grid>

                <Border Grid.Row="1" Classes="divider" />

                <!-- Tab body -->
                <Panel Grid.Row="2">

                    <!-- Working-tree changes -->
                    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsChangesTab}">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="9"
                              Margin="14,11">
                            <CheckBox Grid.Column="0" IsChecked="{Binding AreAllStaged, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                                       Text="{Binding StagedCountLabel}" />
                        </Grid>

                        <Border Grid.Row="1" Classes="divider" />

                        <ListBox Grid.Row="2" Classes="plain"
                                 ItemsSource="{Binding Changes}"
                                 SelectedItem="{Binding SelectedChange, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileChangeViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9"
                                          Margin="14,7">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsStaged, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="body" Text="{Binding FileName}" />
                                            <TextBlock Classes="muted" Text="{Binding Directory}"
                                                       IsVisible="{Binding HasDirectory}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <TextBlock Classes="muted"
                                                       Foreground="{DynamicResource StatusAdded}"
                                                       Text="{Binding AdditionsLabel}" />
                                            <TextBlock Classes="muted"
                                                       Foreground="{DynamicResource StatusDeleted}"
                                                       Text="{Binding DeletionsLabel}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Classes="statusGlyph"
                                                   Classes.added="{Binding IsAdded}"
                                                   Classes.modified="{Binding IsModified}"
                                                   Classes.deleted="{Binding IsDeleted}"
                                                   Classes.renamed="{Binding IsRenamed}"
                                                   Text="{Binding StatusGlyph}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Commit history -->
                    <ListBox Classes="plain"
                             IsVisible="{Binding IsHistoryTab}"
                             ItemsSource="{Binding History}"
                             SelectedItem="{Binding SelectedCommit, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:CommitInfo">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="14,10">
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                            VerticalAlignment="Top"
                                            Background="{Binding AvatarHex, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding AuthorInitials}"
                                                   FontSize="11" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Classes="body" Text="{Binding Summary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Classes="muted" Text="{Binding AuthorName}" />
                                            <TextBlock Classes="muted" Text="·" />
                                            <TextBlock Classes="muted" Text="{Binding RelativeTime}" />
                                            <TextBlock Classes="muted" FontFamily="{DynamicResource MonoFont}"
                                                       Text="{Binding ShortSha}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>

                <!-- Commit box (Changes tab only) -->
                <StackPanel Grid.Row="3" Spacing="9" Margin="14"
                            IsVisible="{Binding IsChangesTab}">
                    <Border Classes="divider" Margin="-14,0,-14,4" />
                    <TextBox Classes="commitBox"
                             PlaceholderText="{Binding CommitSummaryPlaceholder}"
                             Text="{Binding CommitSummary, Mode=TwoWay}" />
                    <TextBox Classes="commitBox"
                             PlaceholderText="Description"
                             Text="{Binding CommitDescription, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="76" />
                    <Button Classes="primary" HorizontalAlignment="Stretch"
                            Command="{Binding CommitCommand}"
                            Content="{Binding CommitButtonLabel}" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Classes="paneSplitter" />

        <!-- ======================= Detail pane ======================= -->
        <Panel Grid.Column="2" Background="{DynamicResource AppBackground}">

            <!-- Selected working-tree file. No outer ScrollViewer: DiffView fills the
                 pane and scrolls itself, so its scrollbars sit at the pane's edges. -->
            <ContentControl IsVisible="{Binding IsChangesTab}" Margin="18"
                            Content="{Binding SelectedChange}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:FileChangeViewModel">
                        <views:DiffView DataContext="{Binding Model}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Clean working tree -->
            <TextBlock IsVisible="{Binding IsChangesTab}"
                       Classes="caption"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="No local changes."
                       ZIndex="-1" />

            <!-- Selected commit: header across the top, then files | splitter | diff. -->
            <Grid IsVisible="{Binding IsHistoryTab}" RowDefinitions="Auto,*">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding CommitFilesWidth, Mode=TwoWay}"
                                      MinWidth="180" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- A ContentControl, not a Border with IsVisible: the template isn't
                     realised until SelectedCommit is non-null, so nothing binds against
                     a null commit and the debug console stays quiet. -->
                <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                Margin="18,18,18,0"
                                Content="{Binding SelectedCommit}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="m:CommitInfo">
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                VerticalAlignment="Top"
                                                Background="{Binding AvatarHex, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding AuthorInitials}"
                                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Classes="h2" Text="{Binding Summary}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Classes="caption" Text="{Binding AuthorName}" />
                                                <TextBlock Classes="muted" Text="committed" />
                                                <TextBlock Classes="muted" Text="{Binding RelativeTime}" />
                                                <TextBlock Classes="muted" Text="·" />
                                                <!-- Lives on the view model, not the commit, so it
                                                     reaches back out of the template. -->
                                                <TextBlock Classes="muted"
                                                           Text="{Binding $parent[views:RepositoryView].((vm:MainWindowViewModel)DataContext).SelectedCommitFilesLabel}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Classes="chip" VerticalAlignment="Top">
                                            <TextBlock Classes="mono" Foreground="{DynamicResource TextSecondary}"
                                                       Text="{Binding ShortSha}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                <!-- Files in this commit. Clicking one shows its diff on the right. -->
                <ListBox Grid.Row="1" Grid.Column="0" Classes="plain" Margin="0,12,0,0"
                         ItemsSource="{Binding SelectedCommitFiles}"
                         SelectedItem="{Binding SelectedCommitFile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:FileChange">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"
                                  Margin="18,7,10,7">
                                <TextBlock Grid.Column="0"
                                           Classes="statusGlyph"
                                           Classes.added="{Binding IsAdded}"
                                           Classes.modified="{Binding IsModified}"
                                           Classes.deleted="{Binding IsDeleted}"
                                           Classes.renamed="{Binding IsRenamed}"
                                           Text="{Binding StatusGlyph}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="body" Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted" Text="{Binding Directory}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Directory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="muted"
                                               Foreground="{DynamicResource StatusAdded}"
                                               Text="{Binding Additions, StringFormat='+{0}'}" />
                                    <TextBlock Classes="muted"
                                               Foreground="{DynamicResource StatusDeleted}"
                                               Text="{Binding Deletions, StringFormat='-{0}'}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1" Grid.Column="1" Classes="paneSplitter" />

                <ContentControl Grid.Row="1" Grid.Column="2" Margin="18,12,18,18"
                                Content="{Binding SelectedCommitFile}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="m:FileChange">
                            <views:DiffView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
