<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGui.ViewModels"
             xmlns:m="using:GitGui.Models"
             xmlns:conv="using:GitGui.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="GitGui.Views.AccountsView"
             x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource AppBackground}">
        <StackPanel MaxWidth="920" Margin="32,28,32,48" Spacing="22"
                    HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Spacing="12">
                <Button Classes="secondary" HorizontalAlignment="Left"
                        Command="{Binding ShowRepositoryCommand}"
                        Content="← Back to repository" />
                <TextBlock Classes="h1" Text="Accounts &amp; hosts" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="GitGui talks to any number of git forges at once. Each host keeps its own credentials, so a self-hosted Gitea behind your own domain works exactly like GitHub.com." />
            </StackPanel>

            <!-- Mockup notice -->
            <Border Background="{DynamicResource ElevatedBackground}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,11">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="18" Height="18" CornerRadius="9"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="caption" VerticalAlignment="Center"
                               Text="This is a UI mockup — the accounts below are sample data and nothing is actually connected." />
                </StackPanel>
            </Border>

            <!-- Signed-in accounts -->
            <StackPanel Spacing="12">
                <TextBlock Classes="sectionLabel" Text="SIGNED IN" />
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:Account">
                            <Border Classes="card" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                            VerticalAlignment="Top"
                                            Background="{Binding AvatarHex, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding Initials}"
                                                   FontSize="15" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock Classes="h2" Text="{Binding DisplayName}" />
                                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                                       Text="{Binding Handle}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="hostBadge" Width="18" Height="18"
                                                    Background="{Binding Host.AccentHex, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding Host.Badge}" FontSize="10"
                                                           FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                                       Text="{Binding Host.Name}" />
                                            <TextBlock Classes="muted" VerticalAlignment="Center" Text="·" />
                                            <TextBlock Classes="muted" VerticalAlignment="Center"
                                                       Text="{Binding AuthMethod}" />
                                        </StackPanel>

                                        <TextBlock Classes="muted"
                                                   Text="{Binding RepositoryCount, StringFormat='{}{0} repositories available'}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Classes="secondary" Content="Sign out"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Connected hosts -->
            <StackPanel Spacing="12">
                <TextBlock Classes="sectionLabel" Text="CONNECTED HOSTS" />
                <ItemsControl ItemsSource="{Binding Hosts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:GitHost">
                            <Border Classes="card" Padding="16" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" Classes="hostBadge" Width="34" Height="34"
                                            CornerRadius="8"
                                            Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="14" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" FontSize="14" Text="{Binding Name}" />
                                        <TextBlock Classes="muted" FontFamily="{DynamicResource MonoFont}"
                                                   Text="{Binding BaseUrl}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Border Classes="chip">
                                            <TextBlock Classes="muted" Text="{Binding KindLabel}" />
                                        </Border>
                                        <Border Classes="chip" IsVisible="{Binding IsSelfHosted}">
                                            <TextBlock Classes="muted" Text="Self-hosted" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Add an account -->
            <StackPanel Spacing="12">
                <TextBlock Classes="sectionLabel" Text="ADD AN ACCOUNT" />
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Pick the kind of forge you want to connect. Self-hosted instances ask for a base URL and a personal access token; GitHub.com uses the browser device flow." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="primary" Content="Connect GitHub.com" />
                            <Button Classes="secondary" Content="GitHub Enterprise" />
                            <Button Classes="secondary" Content="Gitea (self-hosted)" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
