<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGui.ViewModels"
        xmlns:m="using:GitGui.Models"
        xmlns:views="using:GitGui.Views"
        xmlns:conv="using:GitGui.Converters"
        xmlns:svc="using:GitGui.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="GitGui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Title="GitGui"
        Icon="/Assets/gitgui.png"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="620"
        Background="{DynamicResource AppBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />              <!-- toolbar -->
            <RowDefinition Height="Auto" />              <!-- busy strip -->
            <RowDefinition Height="*" MinHeight="220" /> <!-- content -->
            <RowDefinition Height="Auto" />              <!-- console drag handle -->
            <!-- Auto while collapsed, absolute once open. MinHeight keeps the header
                 visible no matter how far the splitter is dragged down. -->
            <RowDefinition Height="{Binding ConsoleHeight, Mode=TwoWay}" MinHeight="34" />
        </Grid.RowDefinitions>

        <!-- ============================ Toolbar ============================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid Height="60" Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <!-- Same width as the sidebar, and driven by the same value, so the
                         wordmark stays flush with it when the splitter is dragged. -->
                    <ColumnDefinition Width="{Binding SidebarWidth}" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                            VerticalAlignment="Center" Margin="14,0,18,0">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="G" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GitGui" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Current repository -->
                <Button Grid.Column="1" x:Name="RepositoryPickerButton"
                        Classes="toolbarItem" Margin="0,0,8,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                        <Border Grid.Column="0" Classes="hostBadge"
                                Background="{Binding SelectedRepository.Host.AccentHex, Converter={StaticResource HexToBrush}}">
                            <TextBlock Text="{Binding SelectedRepository.Host.Badge}"
                                       FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="Current repository" />
                            <TextBlock Classes="body" FontWeight="SemiBold"
                                       Text="{Binding SelectedRepository.Name}" />
                        </StackPanel>
                        <Path Grid.Column="2" Classes="icon" Data="{DynamicResource IconChevronDown}" />
                    </Grid>

                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterClasses="picker">
                            <Grid Width="380" RowDefinitions="Auto,Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0" Classes="sectionLabel" Text="REPOSITORIES"
                                           Margin="10,6,10,8" />
                                <Border Grid.Row="1" Classes="divider" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Classes="caption" Margin="10,8"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !HasRepositories}"
                                           Text="No repositories yet. Add a local clone to get started." />

                                <ScrollViewer Grid.Row="2" MaxHeight="420"
                                              IsVisible="{Binding HasRepositories}">
                                    <ItemsControl ItemsSource="{Binding RepositoryGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HostGroupViewModel">
                                                <StackPanel Margin="0,0,0,8">

                                                    <!-- Host group header -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                Margin="10,6,10,6">
                                                        <Border Classes="hostBadge" Width="18" Height="18"
                                                                Background="{Binding Host.AccentHex, Converter={StaticResource HexToBrush}}">
                                                            <TextBlock Text="{Binding Host.Badge}" FontSize="10"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Classes="caption" FontWeight="SemiBold"
                                                                   Text="{Binding Header}" />
                                                        <TextBlock Classes="muted" Text="{Binding SubHeader}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Repositories on this host -->
                                                    <ItemsControl ItemsSource="{Binding Repositories}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="m:RepositoryInfo">
                                                                <Button Classes="rowButton"
                                                                        Click="OnRepositoryRowClick"
                                                                        Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).SelectRepositoryCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                                        <Path Grid.Column="0" Classes="icon"
                                                                              Data="{DynamicResource IconRepo}" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Classes="body"
                                                                                       Text="{Binding Name}" />
                                                                            <TextBlock Classes="muted"
                                                                                       Text="{Binding FullName}" />
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" Classes="chip"
                                                                                IsVisible="{Binding HasVisibility}">
                                                                            <TextBlock Classes="muted"
                                                                                       Text="{Binding VisibilityLabel}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Grid.Row="3" Classes="divider" Margin="0,6" />

                                <StackPanel Grid.Row="4">
                                    <Button Classes="rowButton"
                                            Click="OnRepositoryRowClick"
                                            Command="{Binding AddRepositoryCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Path Classes="icon" Data="{DynamicResource IconPlus}" />
                                            <TextBlock Classes="body" Text="Add local repository…" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="rowButton"
                                            Click="OnRepositoryRowClick"
                                            Command="{Binding ShowCloneCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Path Classes="icon" Data="{DynamicResource IconRepo}" />
                                            <TextBlock Classes="body" Text="Clone from a hosting site…" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Current branch -->
                <Button Grid.Column="2" x:Name="BranchPickerButton"
                        Classes="toolbarItem" Margin="0,0,8,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                        <Path Grid.Column="0" Classes="icon" Data="{DynamicResource IconBranch}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="Current branch" />
                            <TextBlock Classes="body" FontWeight="SemiBold"
                                       Text="{Binding SelectedBranch.Name}" />
                        </StackPanel>
                        <Path Grid.Column="2" Classes="icon" Data="{DynamicResource IconChevronDown}" />
                    </Grid>

                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                FlyoutPresenterClasses="picker">
                            <Grid Width="340" RowDefinitions="Auto,Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0" Classes="sectionLabel" Text="BRANCHES"
                                           Margin="10,6,10,8" />
                                <Border Grid.Row="1" Classes="divider" Margin="0,0,0,6" />
                                <ScrollViewer Grid.Row="2" MaxHeight="380">
                                    <ItemsControl ItemsSource="{Binding Branches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:BranchInfo">
                                                <Button Classes="rowButton"
                                                        Click="OnBranchRowClick"
                                                        Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).SelectBranchCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                        <Path Grid.Column="0" Classes="icon"
                                                              Data="{DynamicResource IconBranch}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Classes="body" Text="{Binding Name}" />
                                                            <TextBlock Classes="muted"
                                                                       Text="{Binding LastCommitSummary}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Classes="muted"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding RelativeTime}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Grid.Row="3" Classes="divider" Margin="0,6" />

                                <!-- New branch. Branches from whatever HEAD is now and
                                     checks it out, which is what "git checkout -b" does. -->
                                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                      Margin="10,0,10,8">
                                    <TextBox Grid.Column="0" Classes="commitBox"
                                             Text="{Binding NewBranchName, Mode=TwoWay}"
                                             PlaceholderText="New branch name" />
                                    <Button Grid.Column="1" Classes="primary" Content="Create"
                                            Click="OnBranchRowClick"
                                            Command="{Binding CreateBranchCommand}" />
                                </Grid>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Fetch / push / pull -->
                <Button Grid.Column="3" Classes="toolbarItem"
                        Command="{Binding SyncCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                        <Path Grid.Column="0" Classes="icon" Data="{DynamicResource IconSync}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="body" FontWeight="SemiBold"
                                       Text="{Binding SyncActionLabel}" />
                            <TextBlock Classes="muted" Text="{Binding SyncDetailLabel}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="chip"
                                IsVisible="{Binding HasSyncCount}">
                            <TextBlock Classes="muted" Text="{Binding SyncCountLabel}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Right-hand controls -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Classes="iconButton" Click="OnToggleTheme" ToolTip.Tip="Toggle theme">
                        <Path Classes="icon" Data="{DynamicResource IconMoon}" x:Name="ThemeIcon" />
                    </Button>
                    <Button Classes="iconButton" Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="Settings">
                        <Path Classes="icon" Data="{DynamicResource IconSettings}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Indeterminate strip while a git operation runs. -->
        <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True"
                     Background="Transparent"
                     Foreground="{DynamicResource AccentBrush}"
                     IsVisible="{Binding IsBusy}" />

        <!-- ============================ Content ============================ -->
        <Panel Grid.Row="2">
            <views:RepositoryView>
                <views:RepositoryView.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsSettingsPageVisible" />
                        <Binding Path="!IsClonePageVisible" />
                    </MultiBinding>
                </views:RepositoryView.IsVisible>
            </views:RepositoryView>

            <views:CloneView IsVisible="{Binding IsClonePageVisible}" />
            <views:SettingsView IsVisible="{Binding IsSettingsPageVisible}" />

            <!-- Branch switch with uncommitted work. A ContentControl so nothing binds
                 against a null prompt, and a scrim so the choice has to be made. -->
            <Border Background="{DynamicResource ScrimBackground}"
                    IsVisible="{Binding HasPendingBranchSwitch}">
                <ContentControl Content="{Binding PendingBranchSwitch}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:BranchSwitchViewModel">
                            <Border Background="{DynamicResource ElevatedBackground}"
                                    BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="22" Width="560" MaxHeight="560">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h2" Text="{Binding Title}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{Binding Summary}" />

                                    <StackPanel Spacing="8">
                                        <RadioButton GroupName="BranchSwitch"
                                                     IsChecked="{Binding IsBringing, Mode=OneWay}"
                                                     Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).BringChangesCommand}"
                                                     Content="Bring my changes with me" />
                                        <RadioButton GroupName="BranchSwitch"
                                                     IsChecked="{Binding LeaveEverything, Mode=OneWay}"
                                                     Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).LeaveChangesCommand}"
                                                     Content="Leave everything here (stash it)" />
                                    </StackPanel>

                                    <Expander Header="Choose which files come with you"
                                              IsVisible="{Binding IsBringing}">
                                        <StackPanel Spacing="6" Margin="0,8,0,0">
                                            <CheckBox Content="All files"
                                                      IsChecked="{Binding AllSelected, Mode=TwoWay}" />
                                            <Border Classes="divider" />
                                            <ScrollViewer MaxHeight="220">
                                                <ItemsControl ItemsSource="{Binding Files}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FileChangeViewModel">
                                                            <Grid ColumnDefinitions="Auto,Auto,*"
                                                                  ColumnSpacing="9" Margin="0,4">
                                                                <CheckBox Grid.Column="0"
                                                                          IsChecked="{Binding IsStaged, Mode=TwoWay}"
                                                                          VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Classes="statusGlyph"
                                                                           Classes.added="{Binding IsAdded}"
                                                                           Classes.modified="{Binding IsModified}"
                                                                           Classes.deleted="{Binding IsDeleted}"
                                                                           Classes.renamed="{Binding IsRenamed}"
                                                                           Text="{Binding StatusGlyph}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Classes="body"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding Path}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Expander>

                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                HorizontalAlignment="Right">
                                        <Button Classes="secondary" Content="Cancel"
                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CancelBranchSwitchCommand}" />
                                        <Button Classes="primary" Content="{Binding ConfirmLabel}"
                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).ConfirmBranchSwitchCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Panel>

        <!-- ======================= Activity console ======================= -->
        <!-- Drag handle. Only there when the console is open; collapsed, the header is
             already the full-width toggle and a handle on top of it would fight it. -->
        <GridSplitter Grid.Row="3" Classes="consoleSplitter"
                      IsVisible="{Binding IsConsoleExpanded}" />

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*"
              Background="{DynamicResource ToolbarBackground}">

            <Border Grid.Row="0" Classes="divider" />

            <!-- The header IS the toggle, expanded or not. -->
            <Grid Grid.Row="1" ColumnDefinitions="*">
                <Button Grid.Column="0" Classes="consoleBar"
                        Command="{Binding ToggleConsoleCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                VerticalAlignment="Center"
                                Classes="logDot"
                                Classes.trace="{Binding LatestEntry.IsTrace, FallbackValue=False}"
                                Classes.success="{Binding LatestEntry.IsSuccess, FallbackValue=False}"
                                Classes.warning="{Binding LatestEntry.IsWarning, FallbackValue=False}"
                                Classes.error="{Binding LatestEntry.IsError, FallbackValue=False}" />

                        <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                                   Text="{Binding LatestEntry.Message, FallbackValue='Ready'}" />

                        <!-- Chevron only. Points up to expand, down to collapse. -->
                        <Path Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                              Data="{DynamicResource IconChevronDown}"
                              RenderTransformOrigin="50%,50%"
                              RenderTransform="rotate(180deg)"
                              IsVisible="{Binding !IsConsoleExpanded}" />
                        <Path Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                              Data="{DynamicResource IconChevronDown}"
                              IsVisible="{Binding IsConsoleExpanded}" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Expanded log. No fixed height: the row it sits in is what's dragged. -->
            <Grid Grid.Row="2" RowDefinitions="*"
                  IsVisible="{Binding IsConsoleExpanded}">

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
                    <ScrollViewer x:Name="LogScroller" Padding="14,8">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:ActivityEntry">
                                    <StackPanel Margin="0,1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Classes="mono"
                                                       Foreground="{DynamicResource DiffGutterText}"
                                                       Text="{Binding Timestamp}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="mono logLine"
                                                       Classes.trace="{Binding IsTrace}"
                                                       Classes.success="{Binding IsSuccess}"
                                                       Classes.warning="{Binding IsWarning}"
                                                       Classes.error="{Binding IsError}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Message}" />
                                        </Grid>
                                        <TextBlock Classes="mono" FontSize="11"
                                                   Margin="72,2,0,6"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasDetail}"
                                                   Text="{Binding Detail}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
