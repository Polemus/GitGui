<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Typography ===================== -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.sectionLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- ===================== Toolbar ===================== -->

    <!-- The wide dropdown buttons: repository picker, branch picker, sync. -->
    <Style Selector="Button.toolbarItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.toolbarItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>

    <Style Selector="Button.toolbarItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
    </Style>

    <!-- Small square icon button (theme toggle, overflow menu). -->
    <Style Selector="Button.iconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- ===================== Primary action ===================== -->

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- Flat row used inside picker flyouts and list overlays. -->
    <Style Selector="Button.rowButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.rowButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <!-- ===================== Tabs ===================== -->

    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <Style Selector="Button.tab.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===================== Inputs ===================== -->

    <Style Selector="TextBox.commitBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox.commitBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===================== Badges &amp; chips ===================== -->

    <!-- Square host badge carrying the forge's brand colour. -->
    <Style Selector="Border.hostBadge">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== File status letters ===================== -->

    <Style Selector="TextBlock.statusGlyph">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Width" Value="14" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.statusGlyph.added">
        <Setter Property="Foreground" Value="{DynamicResource StatusAdded}" />
    </Style>
    <Style Selector="TextBlock.statusGlyph.modified">
        <Setter Property="Foreground" Value="{DynamicResource StatusModified}" />
    </Style>
    <Style Selector="TextBlock.statusGlyph.deleted">
        <Setter Property="Foreground" Value="{DynamicResource StatusDeleted}" />
    </Style>
    <Style Selector="TextBlock.statusGlyph.renamed">
        <Setter Property="Foreground" Value="{DynamicResource StatusRenamed}" />
    </Style>

    <!-- ===================== Diff rows ===================== -->

    <Style Selector="Border.diffRow">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.diffRow.add">
        <Setter Property="Background" Value="{DynamicResource DiffAddBackground}" />
    </Style>
    <Style Selector="Border.diffRow.remove">
        <Setter Property="Background" Value="{DynamicResource DiffRemoveBackground}" />
    </Style>
    <Style Selector="Border.diffRow.hunk">
        <Setter Property="Background" Value="{DynamicResource DiffHunkBackground}" />
    </Style>

    <Style Selector="Border.diffGutter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.diffGutter.add">
        <Setter Property="Background" Value="{DynamicResource DiffAddGutter}" />
    </Style>
    <Style Selector="Border.diffGutter.remove">
        <Setter Property="Background" Value="{DynamicResource DiffRemoveGutter}" />
    </Style>
    <Style Selector="Border.diffGutter.hunk">
        <Setter Property="Background" Value="{DynamicResource DiffHunkBackground}" />
    </Style>

    <Style Selector="TextBlock.diffText">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource DiffCodeText}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="TextBlock.diffText.add">
        <Setter Property="Foreground" Value="{DynamicResource DiffAddText}" />
    </Style>
    <Style Selector="TextBlock.diffText.remove">
        <Setter Property="Foreground" Value="{DynamicResource DiffRemoveText}" />
    </Style>
    <Style Selector="TextBlock.diffText.hunk">
        <Setter Property="Foreground" Value="{DynamicResource DiffHunkText}" />
    </Style>

    <Style Selector="TextBlock.diffNumber">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource DiffGutterText}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Width" Value="34" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- ===================== Lists ===================== -->

    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>

    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
    </Style>

    <!-- Separator -->
    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- Dropdown surface for the repository and branch pickers. -->
    <Style Selector="FlyoutPresenter.picker">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MaxHeight" Value="540" />
    </Style>

    <!-- Stroked 16x16 icons. Override Stroke per-usage where more contrast is wanted. -->
    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
    </Style>

</Styles>
