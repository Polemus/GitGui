<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GitGui"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="GitGui.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GitGui/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            CustomAccentColor regenerates the whole SystemAccentColor* palette that
            stock controls (CheckBox, ToggleSwitch, Slider, focus rings) pull from.
            Without it those controls keep FluentAvalonia's default indigo while our
            own styles use AccentBrush - which is how the checkboxes ended up purple.
        -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="False"
                                 CustomAccentColor="#3399CC" />
        <StyleInclude Source="avares://GitGui/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
