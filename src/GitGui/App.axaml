<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GitGui"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="GitGui.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GitGui/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            CustomAccentColor is NOT set here on purpose. App.Initialize() assigns it
            from the BrandAccentColor token in Tokens.axaml, so the brand colour lives
            in exactly one place. Hardcoding it here would create a second copy that
            silently drifts out of sync with the design tokens.
        -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="False" />
        <StyleInclude Source="avares://GitGui/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
